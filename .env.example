# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/clinicchain

# Secret used to sign JWT session cookies (use a long random string)
JWT_SECRET=change_this_to_a_long_random_secret

# Port the server runs on
PORT=3000

# --- AI Chatbot (multilingual medical report summaries) ---
# Google Gemini (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: change the Gemini model if Google renames or retires it
GEMINI_MODEL=gemini-3.5-flash
# Optional: choose gemini or anthropic when both keys are present
AI_PROVIDER=gemini
#
# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the model used by the chatbot (defaults to claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Default admin account (used by scripts/seedAdmin.js) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Optional email notifications (doctor approval / rejection emails) ---
# Leave SMTP_HOST empty to disable email. In-app notifications always work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Clinic Chain <no-reply@example.com>
