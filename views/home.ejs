</head>

<body>
   <div id="opening">
    <img src="/images/logo.png" class="opening-logo">
</div>
 

<!-- NAVBAR -->
<div class="navbar">
    <div class="logo-wrap">
        <img src="/images/logo.png" class="logo">
        <span class="brand-name"></span>
    </div>

    <div class="nav">
        <a href="#">Home</a>
        <a href="/about">About us</a>
        <a href="/doctors">Find Doctors</a>
        <a href="/appointment/book">Book Appointment</a>
        <a href="/auth/request-license">Request License</a>
        <a href="/auth/login">Doctor Login</a>
        <a href="/receptionist/login">Receptionist</a>
        <a href="/admin/login">Admin</a>
    </div>
</div>

<!-- HERO -->
<div class="hero">
    <h1>Secure Patient History System</h1>

    <h2 id="quote">
        Connecting clinics, protecting patient history
    </h2>

    <a href="/doctors">
        <button class="btn">Find a Verified Doctor</button>
    </a>
    <a href="/auth/request-license">
        <button class="btn" style="background:#3987d5; border:2px solid #2929e3; margin-left:12px;">I am a Doctor</button>
    </a>
    <a href="/patient/search">
        <button class="btn" style="background:#3987d5; border:2px solid #2929e3; margin-left:12px;">My Records</button>
    </a>
</div>

<!-- FEATURES -->
<div class="features">

    <div class="card">
        <h3>🔒 Secure Records</h3>
        <p>Patient medical reports stored safely with tamper detection.</p>
    </div>

    <div class="card">
        <h3>✅ Verified Doctors Only</h3>
        <p>Doctors send their registration and proof documents. The admin checks them and issues a License ID before they can treat patients.</p>
    </div>

    <div class="card">
        <h3>📱 QR Access</h3>
        <p>Scan QR to instantly view patient health history.</p>
    </div>

    <div class="card">
        <h3>🩺 Search by Specialization</h3>
        <p>Find a verified Gynecologist, Cardiologist, Neurologist, Dermatologist and more, with their clinic and location.</p>
    </div>

    <div class="card">
        <h3>📅 Easy Appointments</h3>
        <p>Book a visit with the right specialist using a simple calendar-based form.</p>
    </div>

    <div class="card">
        <h3>🤖 AI Health Assistant</h3>
        <p>Get your medical report summarized in plain language — in your own language.</p>
    </div>

    <div class="card">
        <h3>🧑‍💼 Front-Desk Ready</h3>
        <p>Receptionists can register walk-in patients and book appointments in seconds.</p>
    </div>

    <div class="card">
        <h3>🛡️ Admin Oversight</h3>
        <p>Admins manage doctors, patients and receptionists, and monitor flagged/unwanted activity.</p>
    </div>

</div>



<!-- ===== FOOTER ===== -->
<footer class="footer">
    
    <div class="social-icons">
        <a href="https://facebook.com" target="_blank">
            <i class="fab fa-facebook-f"></i>
