<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AI Health Assistant - Clinic Chain</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app-body">
<%- include('partials/navbar') %>

<div class="app-wrap" style="max-width:820px;">
  <h1 class="page-title"><i class="fa-solid fa-robot"></i> AI Health Assistant</h1>
  <p class="page-subtitle">Ask about <b><%= patient.name %></b>'s reports (ID: <%= patient.patientId %>) — get a plain-language summary in your own language.</p>

  <% if (!aiConfigured) { %>
    <div class="alert alert-error">
      The AI assistant isn't configured on this server yet. Add <code>GEMINI_API_KEY</code> to the project's <code>.env</code> file to enable it.
    </div>
  <% } %>

  <div class="panel" style="padding:16px 20px;">
    <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center;">
      <label style="font-weight:700; font-size:13px;">Reply in:</label>
      <select id="langSelect" style="padding:8px 12px; border-radius:10px; border:1px solid rgba(11,61,145,0.2);">
        <% languages.forEach(l => { %>
          <option value="<%= l %>" <%= l === patient.preferredLanguage ? 'selected' : '' %>><%= l %></option>
        <% }) %>
      </select>
    </div>

    <div class="record-pick" id="recordPick">
      <button type="button" class="active" data-record="">All records (latest 10)</button>
      <% records.forEach(r => { %>
        <button type="button" data-record="<%= r._id %>"><%= new Date(r.date).toLocaleDateString() %> — <%= r.diagnosis || 'Record' %></button>
      <% }) %>
    </div>
  </div>

  <div class="chat-shell panel" style="padding:0;">
    <div class="chat-messages" id="chatMessages">
      <div class="chat-bubble system">Select a record above (or leave "All records") and ask a question, or tap "Summarize" to get an instant summary.</div>
    </div>
    <div class="chat-input-bar">
      <button id="summarizeBtn" class="btn-sm blue" style="white-space:nowrap;">Summarize</button>
      <input type="text" id="chatInput" placeholder="Ask e.g. 'What does this diagnosis mean?'">
      <button id="sendBtn"><i class="fa-solid fa-paper-plane"></i></button>
    </div>
  </div>
</div>

<script>
  const patientId = "<%= patient.patientId %>";
  const messagesEl = document.getElementById('chatMessages');
  const langSelect = document.getElementById('langSelect');
  const recordButtons = document.querySelectorAll('#recordPick button');
  let selectedRecord = "";

  recordButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      recordButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedRecord = btn.dataset.record;
    });
  });

  function addBubble(text, cls) {
    const div = document.createElement('div');
    div.className = 'chat-bubble ' + cls;
    div.textContent = text;
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return div;
  }

  function addTyping() {
    const div = document.createElement('div');
    div.className = 'chat-bubble ai typing-dots';
    div.innerHTML = '<span></span><span></span><span></span>';
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return div;
  }

  async function askAI(question) {
    const typingEl = addTyping();
    try {
      const res = await fetch('/chatbot/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          patientId,
          recordId: selectedRecord || undefined,
          language: langSelect.value,
          question: question || undefined
        })
      });
      const data = await res.json();
      typingEl.remove();
      addBubble(data.reply, 'ai');
    } catch (err) {
      typingEl.remove();
      addBubble('Something went wrong reaching the AI assistant. Please try again.', 'system');
    }
  }

  document.getElementById('summarizeBtn').addEventListener('click', () => {
    addBubble('Summarize ' + (selectedRecord ? 'this record' : 'my recent records') + ' in ' + langSelect.value, 'user');
    askAI(null);
  });

  document.getElementById('sendBtn').addEventListener('click', sendMessage);
  document.getElementById('chatInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') sendMessage();
  });

  function sendMessage() {
    const input = document.getElementById('chatInput');
    const val = input.value.trim();
    if (!val) return;
    addBubble(val, 'user');
    input.value = '';
    askAI(val);
  }
</script>
<%- include('partials/themeScript') %>
</body>
</html>
