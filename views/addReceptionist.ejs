<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Add Receptionist - Clinic Chain</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app-body">
<%- include('partials/navbar') %>

<div style="display:flex; justify-content:center; padding-top: 30px;">
  <div class="container">
    <h2><i class="fa-solid fa-user-tie"></i> Add Receptionist</h2>
    <% if (error) { %><p style="color:#d9432c; font-size:13px;"><%= error %></p><% } %>

    <form action="/admin/receptionist/add" method="POST">
      <input type="text" name="name" placeholder="Full Name" required>
      <input type="text" name="username" placeholder="Login Username" required>
      <input type="password" name="password" placeholder="Password" required>
      <input type="text" name="clinic" placeholder="Clinic / Branch">
      <input type="text" name="phone" placeholder="Phone Number">
      <button type="submit">Create Account</button>
    </form>
  </div>
</div>
<%- include('partials/themeScript') %>
</body>
</html>
