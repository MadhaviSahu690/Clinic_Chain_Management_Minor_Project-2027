<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Patient History (QR) - Clinic Chain</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app-body">
<%- include('partials/navbar') %>

<div class="app-wrap" style="max-width:700px;">
  <h2 class="page-title">Patient History (QR Access)</h2>

  <% records.forEach(function(record){ %>
    <div class="panel">
      <p><b>Doctor:</b> <%= record.doctor %></p>
      <p><b>Symptoms:</b> <%= record.symptoms %></p>
      <p><b>Diagnosis:</b> <%= record.diagnosis %></p>
      <p><b>Medicines:</b> <%= record.medicines %></p>
      <p><b>Tests:</b> <%= record.tests %></p>

      <% if(record.file){ %>
        <p><b>File:</b>
          <a href="/record/file/<%= record._id %>" target="_blank">View</a> |
          <a href="/record/file/<%= record._id %>?download=true" target="_blank">Download</a>
        </p>
      <% } %>

      <p><small><b>Date:</b> <%= record.date.toLocaleString() %></small></p>
    </div>
  <% }) %>
</div>
<%- include('partials/themeScript') %>
</body>
</html>
